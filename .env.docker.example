# Public URL used by SvelteKit for origin validation.
ORIGIN=https://model-radar.example.com

# Keep 127.0.0.1 when a reverse proxy runs on the same server.
MODEL_RADAR_BIND_ADDRESS=127.0.0.1
MODEL_RADAR_PORT=3000

# Local persistent libSQL database inside the named Docker volume.
DATABASE_URL=file:/app/data/model-radar.db

# To use Turso instead, replace DATABASE_URL and set its token.
# DATABASE_URL=libsql://model-radar-your-org.turso.io
DATABASE_AUTH_TOKEN=

CHEAP_MODEL_MAX_PRICE=1

# Required for POST /api/sync. Generate at least 32 random bytes.
CRON_SECRET=

BODY_SIZE_LIMIT=16K
