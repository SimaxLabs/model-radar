# Optional. Defaults to $1 per 1M tokens using a 3:1 input/output mix.
CHEAP_MODEL_MAX_PRICE=1

# Required for POST /api/sync. Use at least 32 random bytes.
CRON_SECRET=

# Local development default. The parent directory is created automatically.
DATABASE_URL=file:.data/model-radar.db

# Production Turso example: libsql://model-radar-your-org.turso.io
# The token is required whenever DATABASE_URL is not a local file.
DATABASE_AUTH_TOKEN=

# Adapter Node production defaults. Set ORIGIN to the public HTTPS URL in production.
# ORIGIN=https://model-radar.example.com
BODY_SIZE_LIMIT=16K
